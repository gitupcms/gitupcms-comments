{
  "name": "@gitupcms/comments",
  "version": "0.1.0",
  "description": "Self-hosted comments for any website: one script tag, sign-in with Google or GitHub, moderation and email notifications.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitupcms/gitupcms-comments.git"
  },
  "homepage": "https://github.com/gitupcms/gitupcms-comments",
  "bin": {
    "gitupcms-comments": "bin/gitupcms-comments.mjs"
  },
  "files": [
    "bin",
    "dist",
    "src",
    ".env.example"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm build:widget && astro build",
    "build:widget": "vite build -c src/plugins/comments/widget/vite.config.ts",
    "start": "node dist/server/entry.mjs",
    "check": "astro check",
    "test": "node --test \"src/**/*.test.ts\"",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@astrojs/compiler-rs": "0.5.2",
    "@astrojs/node": "^11.1.9",
    "@astrojs/react": "^7.1.2",
    "@data-slot/select": "^1.1.2",
    "@data-slot/tabs": "^1.1.2",
    "@lucide/astro": "^1.66.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.4",
    "bejamas": "^0.6.1",
    "better-auth": "^1.7.15",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/compiler": "4.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "8.3.5"
  }
}
